{
  "name": "tsuna",
  "version": "0.1.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/hoshinoht/tsuna.git" },
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "cargo build --locked --manifest-path native/tsuna/Cargo.toml && bun test ./tests && bun test ./integration/rust-entrypoints.test.ts",
    "test:rust": "cargo test --locked --manifest-path native/tsuna/Cargo.toml",
    "build:rust": "cargo build --locked --release --manifest-path native/tsuna/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "setup": "bin/tsuna setup",
    "smoke": "bin/tsuna smoke",
    "start": "bin/tsuna"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.0",
    "smol-toml": "^1.7.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
