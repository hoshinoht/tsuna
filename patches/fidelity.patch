+import { expect, test } from "bun:test";
+import { resolve } from "node:path";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent";
+import { streamAnthropic } from "@oh-my-pi/pi-ai/providers/anthropic";
+import { streamOpenAIResponses } from "@oh-my-pi/pi-ai/providers/openai-responses";
+
+type Hook = (event: { payload?: unknown; messages?: unknown[] }, ctx: unknown) => Promise<unknown> | unknown;
+
+async function childRequestHook(provider: "cliproxy-openai" | "cliproxy-anthropic", api: "openai-responses" | "anthropic-messages") {
+	const loaded = await loadExtensions([resolve(import.meta.dir, "../extensions/runtime.ts")], import.meta.dir);
+	const handlers = loaded.extensions[0]!.handlers;
+	const contextHook = handlers.get("context")![0] as Hook;
+	const requestHook = handlers.get("before_provider_request")![0] as Hook;
+	const context = {
+		sessionManager: { getSessionId: () => "wire-child" },
+		ui: { notify: () => {}, setStatus: () => {} },
+		hasUI: false,
+		agent: { kind: "sub", name: "tester" },
+		model: { provider, id: "wire-model", api, thinking: { efforts: ["low", "medium", "high"] } },
+	};
+	await contextHook({ messages: [{ role: "user", content: "[reasoning:deep] wire test" }] }, context);
+	return async (payload: unknown) => requestHook({ payload }, context);
+}
+
+async function drain(stream: AsyncIterable<unknown>): Promise<unknown> {
+	try {
+		for await (const _event of stream) {
+			// The mocked server returns an invalid stream; the request capture is the assertion target.
+		}
+		return await (stream as unknown as { result(): Promise<unknown> }).result();
+	} catch (error) {
+		return error;
+	}
+}
+
+test("OMP's provider serializers consume child-only wire replacements before mocked fetch", async () => {
+	const openaiPayloads: unknown[] = [];
+	const openaiHook = await childRequestHook("cliproxy-openai", "openai-responses");
+	const openaiFetch = (async (_input: URL | RequestInfo, init?: RequestInit) => {
+		openaiPayloads.push(JSON.parse(String(init?.body)));
+		return new Response("mock failure", { status: 400 });
+	}) as unknown as typeof fetch;
+	const openaiFailure = await drain(streamOpenAIResponses(
+		{ api: "openai-responses", provider: "cliproxy-openai", id: "wire-model", name: "Wire model", identity: { class: "openai" }, baseUrl: "https://mock.invalid/v1", maxTokens: 16, reasoning: true, thinking: { efforts: ["low", "medium", "high"] }, compat: {}, input: ["text"] } as never,
+		{ systemPrompt: [], messages: [{ role: "user", content: [{ type: "text", text: "hello" }], timestamp: 1 }] } as never,
+		{ apiKey: "test", reasoning: "medium", fetch: openaiFetch, onPayload: openaiHook, streamFirstEventTimeoutMs: 1 },
+	));
+	if (!openaiPayloads[0]) throw openaiFailure;
+	expect(openaiPayloads[0]).toMatchObject({ reasoning: { effort: "medium" } });
+
+	const anthropicPayloads: unknown[] = [];
+	const anthropicHook = await childRequestHook("cliproxy-anthropic", "anthropic-messages");
+	const anthropicFetch = (async (_input: URL | RequestInfo, init?: RequestInit) => {
+		anthropicPayloads.push(JSON.parse(String(init?.body)));
+		return new Response("mock failure", { status: 400 });
+	}) as unknown as typeof fetch;
+	const anthropicFailure = await drain(streamAnthropic(
+		{ api: "anthropic-messages", provider: "cliproxy-anthropic", id: "wire-model", name: "Wire model", identity: { class: "anthropic" }, baseUrl: "https://mock.invalid", maxTokens: 16, reasoning: true, thinking: { mode: "anthropic-adaptive", efforts: ["low", "medium", "high"] }, compat: {}, input: ["text"] } as never,
+		{ systemPrompt: [], messages: [{ role: "user", content: [{ type: "text", text: "hello" }], timestamp: 1 }] } as never,
+		{ apiKey: "test", reasoning: "medium", fetch: anthropicFetch, onPayload: anthropicHook, streamFirstEventTimeoutMs: 1 } as never,
+	));
+	if (!anthropicPayloads[0]) throw anthropicFailure;
+	expect(anthropicPayloads[0]).toMatchObject({ output_config: { effort: "medium" } });
+});
