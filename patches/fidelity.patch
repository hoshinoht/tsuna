diff --git a/tests/compression.test.ts b/tests/compression.test.ts
new file mode 100644
index 0000000..9cbf66b
--- /dev/null
+++ b/tests/compression.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, test } from "bun:test";
+import { resolve } from "node:path";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent";
+import {
+	applyCompression,
+	compressionNudge,
+	createCompressionState,
+	decompress,
+	renderCompressedContext,
+	recompress,
+	restoreCompression,
+} from "../lib/compression.ts";
+
+const user = (text: string, timestamp: number) => ({ role: "user", content: text, timestamp });
+const assistant = (text: string, timestamp: number) => ({ role: "assistant", content: [{ type: "text", text }], timestamp });
+const toolCall = (id: string, timestamp: number) => ({ role: "assistant", content: [{ type: "toolCall", id, name: "read", arguments: { path: "/tmp/a" } }], timestamp });
+const toolResult = (id: string, timestamp: number) => ({ role: "toolResult", toolCallId: id, toolName: "read", content: [{ type: "text", text: "large output" }], isError: false, timestamp });
+
+describe("outbound range compression", () => {
+	test("accepts stable IDs, expands tool pairs, and leaves the stored transcript unchanged", () => {
+		const messages = [user("keep exactly", 1), toolCall("call", 2), toolResult("call", 3), assistant("done", 4)];
+		const original = structuredClone(messages);
+		const state = createCompressionState();
+		const [range] = applyCompression(state, messages, { topic: "read", ranges: [{ startId: "@3@", endId: "@4@", summary: "Read completed." }] });
+		expect(range).toMatchObject({ start: 1, end: 3 });
+		expect(messages).toEqual(original);
+		const rendered = renderCompressedContext(state, messages);
+		expect(rendered[0]).toEqual(messages[0]);
+		expect(JSON.stringify(rendered)).toContain("Read completed.");
+		expect(JSON.stringify(rendered)).not.toContain("large output");
+	});
+
+	test("rejects bad ranges atomically", () => {
+		const state = createCompressionState();
+		const messages = [user("u", 1), assistant("a", 2), assistant("b", 3)];
+		expect(() => applyCompression(state, messages, { topic: "bad", ranges: [{ startId: "@3@", endId: "@1@", summary: "x" }] })).toThrow("reversed");
+		expect(state.ranges.size).toBe(0);
+		expect(() => applyCompression(state, messages, { topic: "bad", ranges: [{ startId: "@2@", endId: "@3@", summary: "x" }, { startId: "@3@", endId: "@3@", summary: "y" }] })).toThrow("overlap");
+		expect(state.ranges.size).toBe(0);
+	});
+
+	test("nests summaries, persists state, and restores/recompresses originals", () => {
+		const messages = [user("verbatim user", 1), assistant("a", 2), assistant("b", 3), assistant("c", 4)];
+		const state = createCompressionState();
+		const [first] = applyCompression(state, messages, { topic: "first", ranges: [{ startId: "@2@", endId: "@3@", summary: "first summary" }] });
+		const [second] = applyCompression(state, messages, { topic: "nested", ranges: [{ startId: "@1@", endId: "@4@", summary: "nested summary" }] });
+		expect(state.ranges.get(first.id)?.active).toBe(false);
+		expect(renderCompressedContext(state, messages).map(message => (message as { content?: unknown }).content)).toContain("verbatim user");
+		expect(JSON.stringify(renderCompressedContext(state, messages))).toContain("first summary");
+		expect(decompress(state, second.id)).toBe(true);
+		expect(state.ranges.get(first.id)?.active).toBe(true);
+		expect(recompress(state, second.id, messages)).toBe(true);
+		const restored = createCompressionState();
+		restoreCompression(restored, [...state.ranges.values()].map(data => ({ type: "custom", customType: "hoshi-dcp-range", data })));
+		expect(renderCompressedContext(restored, messages)).toEqual(renderCompressedContext(state, messages));
+	});
+
+	test("nudges only at configured cadence and emergency anchors", () => {
+		const state = createCompressionState();
+		const messages = [user("u", 1), ...Array.from({ length: 15 }, (_, index) => assistant(String(index), index + 2))];
+		expect(compressionNudge(state, 200_000, messages)).toContain("200k");
+		expect(compressionNudge(state, 200_000, messages)).toBeUndefined();
+		applyCompression(state, messages, { topic: "x", ranges: [{ startId: "@2@", endId: "@2@", summary: "x" }] });
+		const more = [...messages, ...Array.from({ length: 5 }, (_, index) => assistant(`e${index}`, index + 20))];
+		expect(compressionNudge(state, 450_001, more)).toContain("450k");
+	});
+});
+
+test("loads OMP compression commands and guarded tools", async () => {
+	const loaded = await loadExtensions([resolve(import.meta.dir, "../extensions/compression.ts")], import.meta.dir);
+	expect(loaded.errors).toEqual([]);
+	expect([...loaded.extensions[0]!.commands.keys()]).toEqual(["hoshi-dcp"]);
+	expect([...loaded.extensions[0]!.tools.keys()].sort()).toEqual(["compress", "dcp_inspect"]);
+	const compress = loaded.extensions[0]!.tools.get("compress")!.definition;
+	await expect(compress.execute("call", { topic: "x", ranges: [{ startId: "@1@", endId: "@1@", summary: "x" }] }, undefined, undefined, {
+		agent: { kind: "sub", name: "tester" },
+		sessionManager: { getBranch: () => [] },
+	} as never)).rejects.toThrow("primary agent");
+});
