new file mode 100644
index 0000000..8d54f4e
--- /dev/null
+++ b/lib/long-context.ts
@@ -0,0 +1,108 @@
+export const DEFAULT_PROVIDER_ID = "openai";
+export const DEFAULT_PREFIXES = ["gpt-5.6-", "gpt-6-", "gpt-6."] as const;
+export const DEFAULT_SUFFIX = "-1m";
+export const DEFAULT_LIMIT = { context: 1_000_000, input: 872_000, output: 128_000 } as const;
+
+export interface LongContextOptions {
+	enabled: boolean;
+	providerID: string;
+	modelPrefix: string;
+	modelPrefixes: string[];
+	suffix: string;
+	nameSuffix: string;
+	limit: { context: number; input: number; output: number };
+}
+
+export interface ModelLike {
+	id: string;
+	provider: string;
+	modelID?: string;
+	name?: string;
+}
+
+export type LongContextVariant<T extends Record<string, unknown>> = Omit<T, "id" | "modelID" | "name" | "contextWindow" | "maxContextWindow" | "maxTokens"> & { id: string; modelID: string; name: string; contextWindow: number; maxContextWindow: number; maxTokens: number };
+
+function nonEmpty(value: unknown, name: string): string {
+	if (typeof value !== "string" || value.length === 0) throw new Error(`openai-long-context: options.${name} must be a non-empty string`);
+	return value;
+}
+
+function limit(value: unknown): LongContextOptions["limit"] {
+	if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("openai-long-context: options.limit must be an object");
+	const raw = value as Record<string, unknown>;
+	if (Object.keys(raw).some(key => !["context", "input", "output"].includes(key))) throw new Error("openai-long-context: unknown options.limit key");
+	for (const key of ["context", "input", "output"] as const) if (!Number.isSafeInteger(raw[key]) || (raw[key] as number) <= 0) throw new Error(`openai-long-context: options.limit.${key} must be a positive integer`);
+	if ((raw.input as number) > (raw.context as number) || (raw.output as number) > (raw.context as number)) throw new Error("openai-long-context: input and output must not exceed context");
+	return raw as LongContextOptions["limit"];
+}
+
+/** Exact source option contract, kept independent of the host model registry. */
+export function validateLongContextOptions(raw: unknown): LongContextOptions {
+	if (raw !== undefined && raw !== null && (typeof raw !== "object" || Array.isArray(raw))) throw new Error("openai-long-context: options must be an object");
+	const value = (raw ?? {}) as Record<string, unknown>;
+	const known = new Set(["enabled", "providerID", "modelPrefix", "modelPrefixes", "suffix", "nameSuffix", "limit"]);
+	for (const key of Object.keys(value)) if (!known.has(key)) throw new Error(`openai-long-context: unknown option '${key}'`);
+	const modelPrefix = value.modelPrefix === undefined ? "gpt-5.6-" : nonEmpty(value.modelPrefix, "modelPrefix");
+	const modelPrefixes = value.modelPrefixes === undefined
+		? (value.modelPrefix === undefined ? [...DEFAULT_PREFIXES] : [modelPrefix])
+		: (Array.isArray(value.modelPrefixes) && value.modelPrefixes.length > 0 ? value.modelPrefixes.map((item, i) => nonEmpty(item, `modelPrefixes[${i}]`)) : (() => { throw new Error("openai-long-context: options.modelPrefixes must be a non-empty array"); })());
+	if (value.enabled !== undefined && typeof value.enabled !== "boolean") throw new Error("openai-long-context: options.enabled must be a boolean");
+	return {
+		enabled: value.enabled ?? true,
+		providerID: value.providerID === undefined ? DEFAULT_PROVIDER_ID : nonEmpty(value.providerID, "providerID"),
+		modelPrefix,
+		modelPrefixes,
+		suffix: value.suffix === undefined ? DEFAULT_SUFFIX : nonEmpty(value.suffix, "suffix"),
+		nameSuffix: value.nameSuffix === undefined ? " (1M context)" : nonEmpty(value.nameSuffix, "nameSuffix"),
+		limit: value.limit === undefined ? { ...DEFAULT_LIMIT } : limit(value.limit),
+	};
+}
+
+export function isEligibleLongContextModel(id: string, options: LongContextOptions): boolean {
+	return !id.endsWith(options.suffix) && options.modelPrefixes.some(prefix => id.startsWith(prefix));
+}
+
+function clone<T>(value: T): T {
+	return structuredClone(value);
+}
+
+/** Full catalog variant for setup generation; non-identity metadata is retained. */
+export function longContextVariants<T extends Record<string, unknown> & ModelLike>(models: Iterable<T>, options: LongContextOptions): LongContextVariant<T>[] {
+	if (!options.enabled) return [];
+	const variants: LongContextVariant<T>[] = [];
+	for (const model of models) {
+		if (model.provider !== options.providerID || !isEligibleLongContextModel(model.id, options)) continue;
+		const inherited = clone(model) as Record<string, unknown>;
+		delete inherited.id;
+		delete inherited.modelID;
+		delete inherited.name;
+		delete inherited.contextWindow;
+		delete inherited.maxContextWindow;
+		delete inherited.maxTokens;
+		variants.push({
+			...inherited,
+			id: `${model.id}${options.suffix}`,
+			modelID: typeof model.modelID === "string" && model.modelID.length > 0 ? model.modelID : model.id,
+			name: `${typeof model.name === "string" && model.name.length > 0 ? model.name : model.id}${options.nameSuffix}`,
+			contextWindow: options.limit.context,
+			// OMP re-applies this cap when /extended-context changes. The source
+			// variant replaces its entire limit tuple, so a base premium cap must
+			// never pull the alias below its configured 1M window.
+			maxContextWindow: options.limit.context,
+			maxTokens: options.limit.output,
+		} as LongContextVariant<T>);
+	}
+	return variants;
+}
+
+/** Rewrites only the OpenAI wire field; the local selected alias stays intact. */
+export function rewriteLongContextPayload(payload: unknown, model: (Pick<ModelLike, "id" | "provider" | "modelID"> & { requestModelId?: string }) | undefined, options: LongContextOptions): unknown {
+	const baseId = model?.id.endsWith(options.suffix) ? model.id.slice(0, -options.suffix.length) : undefined;
+	if (!options.enabled || !model || model.provider !== options.providerID || !baseId || !isEligibleLongContextModel(baseId, options) || !payload || typeof payload !== "object" || Array.isArray(payload)) return payload;
+	const record = payload as Record<string, unknown>;
+	if (record.model !== model.id) return payload;
+	const wireId = typeof model.requestModelId === "string" && model.requestModelId.length > 0
+		? model.requestModelId
+		: typeof model.modelID === "string" && model.modelID.length > 0 ? model.modelID : baseId;
+	return { ...record, model: wireId };
+}
