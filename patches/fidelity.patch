new file mode 100644
index 0000000..a5ac21c
--- /dev/null
+++ b/extensions/notifier.ts
@@ -0,0 +1,16 @@
+import { spawn } from "node:child_process";
+import type { ExtensionAPI } from "@oh-my-pi/pi-coding-agent";
+import { Notifier, defaultNotifierConfig, projectTitle, type NotifierAdapter } from "../lib/notifier.ts";
+import { emitNotifyEvent, onNotifyEvent } from "../lib/notify-events.ts";
+
+const adapter: NotifierAdapter = {
+	focused: () => undefined,
+	desktop: async (title, body) => { if (process.platform === "darwin") spawn("osascript", ["-e", `display notification ${JSON.stringify(body)} with title ${JSON.stringify(title)}`], { stdio: "ignore", detached: true }).unref(); },
+	sound: async (event, volume) => { if (process.platform === "darwin") { const file = new URL(`../assets/notifier/${event}.wav`, import.meta.url); spawn("afplay", ["-v", String(volume), file.pathname], { stdio: "ignore", detached: true }).unref(); } },
+};
+export default function notifierExtension(pi: ExtensionAPI): void {
+	const notifier = new Notifier(defaultNotifierConfig(), adapter);
+	const dispose = onNotifyEvent(event => notifier.notify(event));
+	pi.on("session_shutdown", () => dispose());
+	pi.on("agent_end", async (event, ctx) => { if (event.willContinue) return; await emitNotifyEvent({ type: ctx.agent.kind === "sub" ? "subagent_complete" : "complete", sessionId: ctx.sessionManager.getSessionId(), agent: ctx.agent.name, title: projectTitle(ctx.cwd) }); });
+}
