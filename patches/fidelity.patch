@@ -0,0 +1,66 @@
+import { getBundledModel, getBundledModels } from "@oh-my-pi/pi-catalog";
+import { longContextVariants, validateLongContextOptions } from "./long-context";
+
+export interface HelperRole { model: string; sourceModel: string }
+export interface CatalogDefinition extends Record<string, unknown> {
+  id: string; name: string; provider: string; contextWindow: number; maxTokens: number;
+}
+
+// Persist only fields supported by OMP's ModelDefinitionSchema. Credentials,
+// account-access metadata and upstream URLs must never enter the proxy catalog.
+const DEFINITION_FIELDS = [
+  "reasoning", "thinking", "input", "imageInputDecoder", "tokenizer", "supportsTools",
+  "cost", "promptCache", "contextWindow", "maxContextWindow", "maxTokens",
+  "omitMaxOutputTokens", "preferWebsockets", "compat", "premiumMultiplier",
+] as const;
+
+function definition(model: Record<string, unknown>, provider: string, compactionModel?: string): CatalogDefinition {
+  const fields = Object.fromEntries(DEFINITION_FIELDS.filter(k => model[k] !== undefined).map(k => [k, structuredClone(model[k])]));
+  return {
+    ...fields, id: String(model.id), name: `${model.name ?? model.id} (CLIProxyAPI)`, provider,
+    contextWindow: Number(model.contextWindow), maxTokens: Number(model.maxTokens),
+    ...(compactionModel ? { compactionModel } : {}),
+  };
+}
+
+export function buildProxyCatalog(sourceModels: string[], rawOptions: unknown, helpers: Record<string, HelperRole>) {
+  const sourceOptions = validateLongContextOptions(rawOptions);
+  const options = { ...sourceOptions, providerID: sourceOptions.providerID === "openai" ? "cliproxy-openai" : sourceOptions.providerID };
+  const rows = new Map<string, CatalogDefinition>();
+  const add = (model: Record<string, unknown>, provider: string) => {
+    const row = definition(model, provider, helpers.compaction?.model);
+    rows.set(`${provider}/${row.id}`, row);
+  };
+  // The source plugin transforms the whole available provider catalog. Role
+  // assignments must not decide which model variants exist in the picker.
+  for (const model of getBundledModels("openai-codex")) add(model as unknown as Record<string, unknown>, "cliproxy-openai");
+  for (const selector of sourceModels) {
+    const [provider, rawId] = selector.split("#")[0].split("/");
+    if (provider !== "openai" && provider !== "anthropic") throw new Error(`Unsupported imported provider: ${provider}`);
+    const id = rawId.replace(/-1m$/, "");
+    const family = provider === "openai" ? "openai-codex" : "anthropic";
+    const model = getBundledModel(family, id);
+    if (!model) throw new Error(`OMP catalog has no ${family}/${id}; refusing guessed model metadata`);
+    add(model as unknown as Record<string, unknown>, `cliproxy-${provider}`);
+  }
+  const variants = longContextVariants(rows.values(), options);
+  const wireIds: Record<string, string> = {};
+  for (const variant of variants) {
+    const item = variant as unknown as CatalogDefinition & { modelID: string };
+    wireIds[`${item.provider}/${item.id}`] = item.modelID;
+    const { modelID: _modelID, ...row } = item;
+    rows.set(`${row.provider}/${row.id}`, row);
+  }
+  const providers: Record<string, { baseUrl: string; api: string; apiKey: string; models: Record<string, unknown>[] }> = {};
+  for (const row of rows.values()) {
+    const provider = row.provider;
+    providers[provider] ??= {
+      baseUrl: provider === "cliproxy-openai" ? "http://127.0.0.1:18317/v1" : "http://127.0.0.1:18317",
+      api: provider === "cliproxy-openai" ? "openai-responses" : "anthropic-messages",
+      apiKey: "HOSHI_PROXY_KEY", models: [],
+    };
+    const { provider: _provider, ...serialized } = row;
+    providers[provider].models.push(serialized);
+  }
+  return { providers, wireIds, options };
+}
