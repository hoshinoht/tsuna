@@ -0,0 +1,10 @@
+import type { ExtensionAPI } from "@oh-my-pi/pi-coding-agent";
+import { rewriteLongContextPayload, validateLongContextOptions } from "../lib/long-context.ts";
+
+const optionsUrl = new URL("../config/plugin-options.json", import.meta.url);
+
+export default async function longContext(pi: ExtensionAPI): Promise<void> {
+	const config = await Bun.file(optionsUrl).json() as Record<string, unknown>;
+	const options = validateLongContextOptions(config["openai-long-context"]);
+	pi.on("before_provider_request", (event, ctx) => rewriteLongContextPayload(event.payload, ctx.model, options));
+}
