+import { basename } from "node:path";
+import type { NotifyEvent, NotifyEventPayload } from "./notify-events.ts";
+
+export interface NotifierConfig { sound: boolean; notification: boolean; suppressWhenFocused: boolean; events: Record<NotifyEvent, { sound: boolean; notification: boolean }>; volumes: Record<NotifyEvent, number> }
+export const defaultNotifierConfig = (): NotifierConfig => ({ sound: true, notification: true, suppressWhenFocused: true, events: { permission: { sound: true, notification: true }, question: { sound: true, notification: true }, complete: { sound: true, notification: true }, subagent_complete: { sound: false, notification: false }, error: { sound: true, notification: true } }, volumes: { permission: 1, question: 1, complete: 1, subagent_complete: 1, error: 1 } });
+export interface NotifierAdapter { focused(): boolean | undefined; desktop(title: string, body: string): Promise<void>; sound(event: NotifyEvent, volume: number): Promise<void> }
+export class Notifier {
+	readonly pending = new Set<string>();
+	constructor(readonly config: NotifierConfig, readonly adapter: NotifierAdapter) {}
+	async notify(event: NotifyEventPayload): Promise<void> {
+		const key = event.key ?? `${event.type}:${event.sessionId ?? "main"}`;
+		if (event.type === "permission") { if (this.pending.has(key)) return; this.pending.add(key); }
+		const focused = this.adapter.focused();
+		if (this.config.suppressWhenFocused && focused === true) return;
+		const settings = this.config.events[event.type];
+		const title = event.type === "permission" ? "Hoshi needs permission" : event.type === "question" ? "Hoshi has a question" : event.type === "error" ? "Hoshi error" : event.type === "subagent_complete" ? "Hoshi subagent complete" : "Hoshi complete";
+		const body = event.title ?? event.agent ?? "Session";
+		if (this.config.notification && settings.notification) await this.adapter.desktop(title, body);
+		if (this.config.sound && settings.sound) await this.adapter.sound(event.type, this.config.volumes[event.type]);
+	}
+	resolvePermission(key?: string): void { if (key) this.pending.delete(key); else this.pending.clear(); }
+}
+export function projectTitle(cwd: string): string { return basename(cwd) || cwd; }
