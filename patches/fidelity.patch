diff --git a/tests/long-context.test.ts b/tests/long-context.test.ts
new file mode 100644
index 0000000..cde7c77
--- /dev/null
+++ b/tests/long-context.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from "bun:test";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Settings, discoverAuthStorage, ModelRegistry } from "@oh-my-pi/pi-coding-agent";
+import { resolve } from "node:path";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent";
+import { longContextVariants, rewriteLongContextPayload, validateLongContextOptions } from "../lib/long-context.ts";
+
+describe("openai long context compatibility", () => {
+	it("preserves source options and covers every eligible provider model", () => {
+		const options = validateLongContextOptions({ providerID: "cliproxy-openai" });
+		const variants = longContextVariants([
+			{ provider: "cliproxy-openai", id: "gpt-5.6-terra", name: "Terra", contextWindow: 400000, maxTokens: 32000 },
+			{ provider: "cliproxy-openai", id: "gpt-6.1-sol", name: "Sol", contextWindow: 400000, maxTokens: 32000 },
+			{ provider: "cliproxy-openai", id: "gpt-6.1-sol-1m", contextWindow: 1000000, maxTokens: 128000 },
+			{ provider: "other", id: "gpt-6-sol", contextWindow: 400000, maxTokens: 32000 },
+		], options);
+		expect(variants.map(model => model.id)).toEqual(["gpt-5.6-terra-1m", "gpt-6.1-sol-1m"]);
+		expect(variants[0]).toMatchObject({ modelID: "gpt-5.6-terra", name: "Terra (1M context)", contextWindow: 1000000, maxContextWindow: 1000000, maxTokens: 128000 });
+	});
+
+	it("supports custom prefix, suffix, limits, and idempotent disabled state", () => {
+		const options = validateLongContextOptions({ providerID: "p", modelPrefix: "custom-", suffix: "-long", limit: { context: 200, input: 100, output: 150 } });
+		expect(longContextVariants([{ provider: "p", id: "custom-a", contextWindow: 10, maxTokens: 999 }], options)).toMatchObject([{ id: "custom-a-long", maxTokens: 150 }]);
+		expect(longContextVariants([{ provider: "p", id: "custom-a-long", contextWindow: 10, maxTokens: 20 }], options)).toEqual([]);
+		expect(longContextVariants([{ provider: "p", id: "custom-a", contextWindow: 10, maxTokens: 20 }], validateLongContextOptions({ enabled: false }))).toEqual([]);
+	});
+
+	it("keeps the selectable alias local while sending the base OpenAI model on the wire", () => {
+		const options = validateLongContextOptions({ providerID: "cliproxy-openai" });
+		const base = { provider: "cliproxy-openai", id: "gpt-6.1-sol-fast", modelID: "gpt-6.1-sol", name: "Sol Fast", contextWindow: 400000, maxTokens: 32000, api: "openai-responses", cost: { input: 1, nested: { copied: true } } };
+		const [variant] = longContextVariants([base], options);
+		expect(variant).toMatchObject({ id: "gpt-6.1-sol-fast-1m", modelID: "gpt-6.1-sol", name: "Sol Fast (1M context)", contextWindow: 1000000, maxContextWindow: 1000000, maxTokens: 128000, api: "openai-responses", cost: { input: 1 } });
+		(base.cost.nested.copied as boolean) = false;
+		expect((variant!.cost as { nested: { copied: boolean } }).nested.copied).toBe(true);
+		expect(rewriteLongContextPayload({ model: variant!.id, input: [] }, variant, options)).toEqual({ model: "gpt-6.1-sol", input: [] });
+		expect(rewriteLongContextPayload({ model: base.id }, base, options)).toEqual({ model: base.id });
+		expect(rewriteLongContextPayload({ model: "gpt-6.1-sol-fast-1m" }, variant, validateLongContextOptions({ enabled: false, providerID: "cliproxy-openai" }))).toEqual({ model: "gpt-6.1-sol-fast-1m" });
+		expect(rewriteLongContextPayload({ model: "wrong" }, variant, options)).toEqual({ model: "wrong" });
+		expect(rewriteLongContextPayload({ model: "other-1m" }, { provider: "cliproxy-openai", id: "other-1m" }, options)).toEqual({ model: "other-1m" });
+	});
+
+	it("rejects invalid source options", () => {
+		expect(validateLongContextOptions(null)).toEqual(validateLongContextOptions(undefined));
+		expect(() => validateLongContextOptions({ unknown: true })).toThrow("unknown option");
+		expect(() => validateLongContextOptions({ limit: { context: 1, input: 2, output: 1 } })).toThrow("must not exceed");
+	});
+
+	it("keeps normal and long aliases distinct in the actual OMP registry", async () => {
+		const root = await mkdtemp(join(tmpdir(), "hoshi-omp-long-context-"));
+		const agentDir = join(root, "agent");
+		try {
+			await mkdir(agentDir, { recursive: true });
+			await writeFile(join(agentDir, "config.yml"), "extendedContext: true\n");
+			await writeFile(join(agentDir, "models.yml"), `providers:\n  cliproxy-openai:\n    baseUrl: http://127.0.0.1:1/v1\n    api: openai-responses\n    apiKey: HOSHI_PROXY_KEY\n    models:\n      - id: gpt-6.1-sol\n        name: Sol\n        reasoning: true\n        input: [text]\n        cost: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0 }\n        contextWindow: 400000\n        maxContextWindow: 872000\n        maxTokens: 32000\n      - id: gpt-6.1-sol-1m\n        name: Sol (1M context)\n        reasoning: true\n        input: [text]\n        cost: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0 }\n        contextWindow: 1000000\n        maxContextWindow: 1000000\n        maxTokens: 128000\n`);
+			const settings = await Settings.loadIsolated({ cwd: root, agentDir });
+			const registry = new ModelRegistry(await discoverAuthStorage(agentDir), join(agentDir, "models.yml"), { settings });
+			expect(registry.find("cliproxy-openai", "gpt-6.1-sol")?.contextWindow).toBe(872000);
+			expect(registry.find("cliproxy-openai", "gpt-6.1-sol-1m")?.contextWindow).toBe(1000000);
+		} finally {
+			await rm(root, { recursive: true, force: true });
+		}
+	});
+
+	it("rewrites an actual extension hook payload without changing the selected alias", async () => {
+		const loaded = await loadExtensions([resolve(import.meta.dir, "../extensions/long-context.ts")], import.meta.dir);
+		expect(loaded.errors).toEqual([]);
+		const hook = loaded.extensions[0]!.handlers.get("before_provider_request")![0] as (event: { payload: unknown }, ctx: { model: unknown }) => unknown;
+		const config = await Bun.file(new URL("../config/plugin-options.json", import.meta.url)).json() as { "openai-long-context"?: { providerID?: string } };
+		const alias = { provider: config["openai-long-context"]?.providerID ?? "openai", id: "gpt-6.1-sol-1m" };
+		expect(hook({ payload: { model: "gpt-6.1-sol-1m", input: [] } }, { model: alias })).toEqual({ model: "gpt-6.1-sol", input: [] });
+		expect(alias.id).toBe("gpt-6.1-sol-1m");
+	});
+});
