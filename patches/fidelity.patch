diff --git a/extensions/compression.ts b/extensions/compression.ts
new file mode 100644
index 0000000..28becec
--- /dev/null
+++ b/extensions/compression.ts
@@ -0,0 +1,107 @@
+import type { ExtensionAPI, ExtensionContext } from "@oh-my-pi/pi-coding-agent";
+import {
+	applyCompression,
+	compressionNudge,
+	compressionStats,
+	createCompressionState,
+	decompress,
+	DCP_ENTRY,
+	renderCompressedContext,
+	recompress,
+	restoreCompression,
+	sweepCompression,
+	type CompressionInput,
+} from "../lib/compression.ts";
+
+function branchMessages(ctx: ExtensionContext): unknown[] {
+	return ctx.sessionManager.getBranch().flatMap(entry => entry.type === "message" ? [entry.message] : []);
+}
+
+function requirePrimary(ctx: ExtensionContext): void {
+	if (ctx.agent.kind !== "main") throw new Error("Compression is available only to the primary agent.");
+}
+
+export default function compressionExtension(pi: ExtensionAPI): void {
+	const state = createCompressionState();
+	const z = pi.zod;
+
+	const restore = (ctx: ExtensionContext) => restoreCompression(state, ctx.sessionManager.getBranch());
+	pi.on("session_start", (_event, ctx) => restore(ctx));
+	pi.on("session_tree", (_event, ctx) => restore(ctx));
+
+	pi.on("context", (event, ctx) => {
+		const messages = renderCompressedContext(state, event.messages);
+		if (ctx.agent.kind === "main" && ctx.hasUI) {
+			const usage = ctx.getContextUsage();
+			const tokens = usage && typeof usage.tokens === "number" ? usage.tokens : undefined;
+			const nudge = compressionNudge(state, tokens, event.messages);
+			if (nudge) ctx.ui.notify(nudge, "info");
+		}
+		return { messages: messages as typeof event.messages };
+	});
+
+	pi.registerCommand("hoshi-dcp", {
+		description: "Inspect and manage outbound range compression.",
+		handler: async (args, ctx) => {
+			requirePrimary(ctx);
+			const [action, id] = args.trim().split(/\s+/, 2);
+			const messages = branchMessages(ctx);
+			if (!action || action === "manual") {
+				ctx.ui.notify("/hoshi-dcp context | stats | decompress <dcp-id> | recompress <dcp-id> | sweep", "info");
+				return;
+			}
+			if (action === "context") {
+				ctx.ui.notify(JSON.stringify(compressionStats(state, messages).targets), "info");
+				return;
+			}
+			if (action === "stats") {
+				ctx.ui.notify(JSON.stringify(compressionStats(state, messages)), "info");
+				return;
+			}
+			if (action === "decompress" && id) {
+				if (!decompress(state, id)) throw new Error("Unknown or inactive compression range.");
+				pi.appendEntry(DCP_ENTRY, state.ranges.get(id));
+				return;
+			}
+			if (action === "recompress" && id) {
+				if (!recompress(state, id, messages)) throw new Error("Compression origin is unavailable or overlaps an active range.");
+				pi.appendEntry(DCP_ENTRY, state.ranges.get(id));
+				return;
+			}
+			if (action === "sweep") {
+				ctx.ui.notify(`Removed ${sweepCompression(state, messages)} stale compression range(s).`, "info");
+				return;
+			}
+			throw new Error("Unknown compression command.");
+		},
+	});
+
+	pi.registerTool({
+		name: "compress",
+		label: "Compress context range",
+		description: "Store a summary for completed @N@ or @bN@ ranges while preserving user messages verbatim.",
+		approval: "write",
+		parameters: z.object({
+			topic: z.string().min(1),
+			ranges: z.array(z.object({ startId: z.string().min(3), endId: z.string().min(3), summary: z.string().min(1) })).min(1),
+		}),
+		async execute(_id, input, _signal, _update, ctx) {
+			requirePrimary(ctx);
+			const created = applyCompression(state, branchMessages(ctx), input as CompressionInput);
+			for (const range of created) pi.appendEntry(DCP_ENTRY, range);
+			return { content: [{ type: "text", text: `Compressed ${created.length} range(s). Original branch messages and user content are unchanged.` }], details: { ranges: created.map(range => range.id) } };
+		},
+	});
+
+	pi.registerTool({
+		name: "dcp_inspect",
+		label: "Inspect compression targets",
+		description: "List stable @N@ and @bN@ targets for outbound range compression.",
+		approval: "read",
+		parameters: z.object({}),
+		async execute(_id, _input, _signal, _update, ctx) {
+			requirePrimary(ctx);
+			return { content: [{ type: "text", text: JSON.stringify(compressionStats(state, branchMessages(ctx))) }], details: {} };
+		},
+	});
+}
