--- /dev/null
+++ b/lib/compression.ts
@@ -0,0 +1,263 @@
+/**
+ * Outbound-only range compression for OMP sessions.
+ *
+ * This module is an independent implementation from the public behavior
+ * contract. It never mutates the persisted branch: range records describe an
+ * overlay reconstructed from custom session entries.
+ */
+
+export interface CompressionInput {
+	topic: string;
+	ranges: Array<{ startId: string; endId: string; summary: string }>;
+}
+
+export interface CompressionRange {
+	id: string;
+	topic: string;
+	start: number;
+	end: number;
+	summary: string;
+	active: boolean;
+	ancestors: string[];
+}
+
+export interface CompressionState {
+	ranges: Map<string, CompressionRange>;
+	nextId: number;
+	lastNudgeAnchor: number;
+}
+
+export const DCP_ENTRY = "hoshi-dcp-range";
+export const DCP_MIN_TOKENS = 200_000;
+export const DCP_MAX_TOKENS = 450_000;
+
+type RecordValue = Record<string, unknown>;
+
+function record(value: unknown): RecordValue | undefined {
+	return value && typeof value === "object" && !Array.isArray(value) ? value as RecordValue : undefined;
+}
+
+function contentText(message: unknown): string {
+	const item = record(message);
+	if (typeof item?.content === "string") return item.content;
+	if (!Array.isArray(item?.content)) return "";
+	return item.content.map(part => {
+		const value = record(part);
+		return typeof value?.text === "string" ? value.text : "";
+	}).filter(Boolean).join("\n");
+}
+
+function isUser(message: unknown): boolean {
+	return record(message)?.role === "user";
+}
+
+function toolPairs(messages: readonly unknown[]): Map<number, number> {
+	const calls = new Map<string, number>();
+	const pairs = new Map<number, number>();
+	messages.forEach((message, index) => {
+		const item = record(message);
+		if (item?.role === "assistant" && Array.isArray(item.content)) {
+			for (const part of item.content) {
+				const call = record(part);
+				if (call?.type === "toolCall" && typeof call.id === "string") calls.set(call.id, index);
+			}
+		}
+		if (item?.role === "toolResult" && typeof item.toolCallId === "string") {
+			const call = calls.get(item.toolCallId);
+			if (call !== undefined) {
+				pairs.set(call, index);
+				pairs.set(index, call);
+			}
+		}
+	});
+	return pairs;
+}
+
+export function createCompressionState(): CompressionState {
+	return { ranges: new Map(), nextId: 1, lastNudgeAnchor: 0 };
+}
+
+export function targetIds(messages: readonly unknown[]): string[] {
+	return messages.flatMap((_message, index) => [`@${index + 1}@`, `@b${index + 1}@`]);
+}
+
+function resolveTarget(value: string, count: number): number | undefined {
+	const match = /^@(?:b)?(\d+)@$/.exec(value.trim());
+	if (!match) return undefined;
+	const index = Number(match[1]) - 1;
+	return Number.isSafeInteger(index) && index >= 0 && index < count ? index : undefined;
+}
+
+function expandToolPairs(start: number, end: number, pairs: ReadonlyMap<number, number>): { start: number; end: number } {
+	let changed = true;
+	while (changed) {
+		changed = false;
+		for (let index = start; index <= end; index += 1) {
+			const pair = pairs.get(index);
+			if (pair === undefined) continue;
+			if (pair < start) { start = pair; changed = true; }
+			if (pair > end) { end = pair; changed = true; }
+		}
+	}
+	return { start, end };
+}
+
+function overlaps(left: CompressionRange, start: number, end: number): boolean {
+	return left.start <= end && start <= left.end;
+}
+
+function validateInput(input: CompressionInput): void {
+	if (!input || typeof input.topic !== "string" || !input.topic.trim()) throw new Error("Compression topic is required.");
+	if (!Array.isArray(input.ranges) || input.ranges.length === 0) throw new Error("At least one compression range is required.");
+	for (const range of input.ranges) {
+		if (!range || typeof range.startId !== "string" || typeof range.endId !== "string" || typeof range.summary !== "string" || !range.summary.trim()) {
+			throw new Error("Each compression range requires startId, endId, and summary.");
+		}
+	}
+}
+
+/** Validate the whole request before changing state; failures are atomic. */
+export function applyCompression(state: CompressionState, messages: readonly unknown[], input: CompressionInput): CompressionRange[] {
+	validateInput(input);
+	const pairs = toolPairs(messages);
+	const pending = input.ranges.map(range => {
+		const rawStart = resolveTarget(range.startId, messages.length);
+		const rawEnd = resolveTarget(range.endId, messages.length);
+		if (rawStart === undefined || rawEnd === undefined) throw new Error("Unknown compression target ID.");
+		if (rawStart > rawEnd) throw new Error("Compression range is reversed.");
+		const expanded = expandToolPairs(rawStart, rawEnd, pairs);
+		return { ...expanded, summary: range.summary.trim() };
+	});
+	for (let left = 0; left < pending.length; left += 1) {
+		for (let right = left + 1; right < pending.length; right += 1) {
+			if (pending[left]!.start <= pending[right]!.end && pending[right]!.start <= pending[left]!.end) throw new Error("Compression ranges overlap or duplicate each other.");
+		}
+	}
+	const active = [...state.ranges.values()].filter(range => range.active);
+	for (const next of pending) {
+		for (const existing of active) {
+			if (!overlaps(existing, next.start, next.end)) continue;
+			if (next.start <= existing.start && existing.end <= next.end) continue;
+			throw new Error("Compression range is already covered or overlaps an active range.");
+		}
+	}
+
+	const created: CompressionRange[] = [];
+	for (const next of pending) {
+		const ancestors = active.filter(existing => next.start <= existing.start && existing.end <= next.end);
+		for (const ancestor of ancestors) ancestor.active = false;
+		const range: CompressionRange = {
+			id: `dcp-${state.nextId++}`,
+			topic: input.topic.trim(),
+			start: next.start,
+			end: next.end,
+			summary: next.summary,
+			active: true,
+			ancestors: ancestors.map(ancestor => ancestor.id),
+		};
+		state.ranges.set(range.id, range);
+		created.push(range);
+	}
+	return created.map(range => ({ ...range, ancestors: [...range.ancestors] }));
+}
+
+function summaryMessage(range: CompressionRange, state: CompressionState, timestamp: number): RecordValue {
+	const visited = new Set<string>();
+	const ancestorText = (id: string): string[] => {
+		if (visited.has(id)) return [];
+		visited.add(id);
+		const ancestor = state.ranges.get(id);
+		return ancestor ? [...ancestor.ancestors.flatMap(ancestorText), ancestor.summary] : [];
+	};
+	return {
+		role: "user",
+		synthetic: true,
+		timestamp,
+		content: [`[Compressed context: ${range.topic}]`, ...range.ancestors.flatMap(ancestorText), range.summary].join("\n\n"),
+		dcp: { id: range.id, startId: `@${range.start + 1}@`, endId: `@${range.end + 1}@` },
+	};
+}
+
+/** Apply active range overlays without mutating the stored branch messages. */
+export function renderCompressedContext(state: CompressionState, messages: readonly unknown[]): unknown[] {
+	const ranges = [...state.ranges.values()].filter(range => range.active).sort((left, right) => left.start - right.start);
+	if (!ranges.length) return [...messages];
+	const output: unknown[] = [];
+	let cursor = 0;
+	for (const range of ranges) {
+		while (cursor < range.start) output.push(messages[cursor++]);
+		for (let index = range.start; index <= range.end; index += 1) {
+			if (isUser(messages[index])) output.push(messages[index]);
+		}
+		const origin = record(messages[range.start]);
+		output.push(summaryMessage(range, state, typeof origin?.timestamp === "number" ? origin.timestamp : range.start + 1));
+		cursor = range.end + 1;
+	}
+	while (cursor < messages.length) output.push(messages[cursor++]);
+	return output;
+}
+
+export function decompress(state: CompressionState, id: string): boolean {
+	const range = state.ranges.get(id);
+	if (!range || !range.active) return false;
+	range.active = false;
+	for (const ancestor of range.ancestors) {
+		const previous = state.ranges.get(ancestor);
+		if (previous) previous.active = true;
+	}
+	return true;
+}
+
+export function recompress(state: CompressionState, id: string, messages: readonly unknown[]): boolean {
+	const range = state.ranges.get(id);
+	if (!range || range.active || range.start < 0 || range.end >= messages.length) return false;
+	if ([...state.ranges.values()].some(other => other.active && !range.ancestors.includes(other.id) && overlaps(other, range.start, range.end))) return false;
+	for (const ancestor of range.ancestors) {
+		const previous = state.ranges.get(ancestor);
+		if (previous) previous.active = false;
+	}
+	range.active = true;
+	return true;
+}
+
+export function restoreCompression(state: CompressionState, entries: readonly unknown[]): void {
+	state.ranges.clear();
+	state.nextId = 1;
+	for (const entry of entries) {
+		const item = record(entry);
+		if (item?.type !== "custom" || item.customType !== DCP_ENTRY) continue;
+		const data = record(item.data);
+		if (!data || typeof data.id !== "string" || typeof data.topic !== "string" || typeof data.start !== "number" || typeof data.end !== "number" || typeof data.summary !== "string" || typeof data.active !== "boolean" || !Array.isArray(data.ancestors)) continue;
+		const range: CompressionRange = { id: data.id, topic: data.topic, start: data.start, end: data.end, summary: data.summary, active: data.active, ancestors: data.ancestors.filter((id): id is string => typeof id === "string") };
+		state.ranges.set(range.id, range);
+		const suffix = /^dcp-(\d+)$/.exec(range.id);
+		if (suffix) state.nextId = Math.max(state.nextId, Number(suffix[1]) + 1);
+	}
+}
+
+export function compressionStats(state: CompressionState, messages: readonly unknown[]): { ranges: number; active: number; targets: string[] } {
+	return { ranges: state.ranges.size, active: [...state.ranges.values()].filter(range => range.active).length, targets: targetIds(messages) };
+}
+
+export function sweepCompression(state: CompressionState, messages: readonly unknown[]): number {
+	let removed = 0;
+	for (const [id, range] of state.ranges) {
+		if (range.start < 0 || range.end < range.start || range.end >= messages.length) {
+			state.ranges.delete(id);
+			removed += 1;
+		}
+	}
+	return removed;
+}
+
+export function compressionNudge(state: CompressionState, contextTokens: number | undefined, messages: readonly unknown[]): string | undefined {
+	if (contextTokens === undefined || contextTokens < DCP_MIN_TOKENS) return;
+	const lastUser = messages.map(isUser).lastIndexOf(true);
+	const anchors = messages.length - (lastUser + 1);
+	const active = [...state.ranges.values()].some(range => range.active);
+	const emergency = contextTokens > DCP_MAX_TOKENS && active && anchors - state.lastNudgeAnchor >= 5;
+	const normal = anchors >= 15 && anchors - state.lastNudgeAnchor >= 15;
+	if (!normal && !emergency) return;
+	state.lastNudgeAnchor = anchors;
+	return `Context is ${Math.round(contextTokens / 1000)}k tokens. Inspect compression targets and use compress with explicit @N@ ranges when a completed section can be summarized.`;
+}
