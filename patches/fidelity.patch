new file mode 100644
index 0000000..5d53bc0
--- /dev/null
+++ b/extensions/status-line.ts
@@ -0,0 +1,62 @@
+import type { ExtensionAPI, ExtensionContext } from "@oh-my-pi/pi-coding-agent";
+import type { TUI } from "@oh-my-pi/pi-tui";
+import * as vcs from "@oh-my-pi/pi-natives/vcs";
+import { diffTotals, type DiffStat, type TokenRecord } from "../packages/status-line-core/format.ts";
+import { cacheSegment, contextSegment, diffSegment, fitLine, speedSegment, timeSegment } from "../packages/status-line-core/line.ts";
+import { beginStep, beginTurn, createMeter, endStep, endTurn, observe, recordedSteps, restoreFinal, speedView, type Meter, type RecordedMessage } from "../packages/status-line-core/rate.ts";
+
+const TICK_MS = 250;
+const DIFF_REFRESH_MS = 5_000;
+interface State { meter: Meter; startedAt: number; lastUsage?: TokenRecord; diff?: { value: DiffStat; at: number }; timer?: ReturnType<typeof setInterval>; }
+
+function hexAnsi(hex: string, text: string): string {
+	const match = /^#(..)(..)(..)$/.exec(hex);
+	return match ? `\x1b[38;2;${Number.parseInt(match[1]!, 16)};${Number.parseInt(match[2]!, 16)};${Number.parseInt(match[3]!, 16)}m${text}\x1b[0m` : text;
+}
+function asTokenRecord(usage: unknown): TokenRecord | undefined {
+	if (!usage || typeof usage !== "object") return undefined;
+	const value = usage as Record<string, unknown>;
+	const number = (key: string) => typeof value[key] === "number" ? value[key] as number : undefined;
+	return { input: number("input"), output: number("output"), reasoning: number("reasoning"), cache: value.cacheRead || value.cacheWrite ? { read: number("cacheRead"), write: number("cacheWrite") } : undefined };
+}
+function render(state: State, ctx: ExtensionContext, width: number): string {
+	const usage = ctx.getContextUsage();
+	const contextTokens = usage ? { input: usage.tokens } : state.lastUsage;
+	const segments = [contextSegment(contextTokens, usage?.contextWindow), cacheSegment(state.lastUsage), speedSegment(speedView(state.meter, Date.now())), diffSegment(state.diff?.value), timeSegment(Date.now() - state.startedAt)].filter((segment): segment is NonNullable<typeof segment> => Boolean(segment));
+	return fitLine(segments, Math.max(1, width)).map(run => hexAnsi(run.fg, run.text)).join("");
+}
+async function refreshDiff(state: State, ctx: ExtensionContext): Promise<void> {
+	if (state.diff && Date.now() - state.diff.at < DIFF_REFRESH_MS) return;
+	try {
+		const repo = vcs.git(ctx.cwd);
+		if (!repo) return;
+		const [unstaged, staged] = await Promise.all([repo.numstat({}), repo.numstat({ cached: true })]);
+		state.diff = { value: diffTotals([...unstaged, ...staged].map(item => ({ additions: item.added, deletions: item.removed }))), at: Date.now() };
+	} catch { state.diff = { value: { added: 0, deleted: 0 }, at: Date.now() }; }
+}
+function restoreMeter(state: State, ctx: ExtensionContext): void {
+	const messages = ctx.sessionManager.getBranch().flatMap(entry => entry.type === "message" ? [entry.message] : []);
+	const recorded: RecordedMessage[] = messages.map(message => {
+		const item = message as unknown as Record<string, unknown>; const usage = asTokenRecord(item.usage);
+		return { type: typeof item.role === "string" ? item.role : undefined, time: { created: typeof item.timestamp === "number" ? item.timestamp : undefined, completed: typeof item.completedAt === "number" ? item.completedAt : undefined }, tokens: usage ? { output: usage.output, reasoning: usage.reasoning } : undefined };
+	});
+	const steps = recordedSteps(recorded); if (steps) restoreFinal(state.meter, steps, Date.now());
+	const first = messages.find(message => typeof (message as unknown as Record<string, unknown>).timestamp === "number") as unknown as Record<string, unknown> | undefined;
+	if (typeof first?.timestamp === "number") state.startedAt = first.timestamp;
+}
+
+export default function statusLine(pi: ExtensionAPI): void {
+	const state: State = { meter: createMeter(), startedAt: Date.now() }; let lastContext: ExtensionContext | undefined; let requestRender: (() => void) | undefined;
+	const install = (ctx: ExtensionContext) => {
+		if (!ctx.hasUI) return; lastContext = ctx;
+		ctx.ui.setWidget("hoshi-status-line", (tui: TUI) => { requestRender = () => tui.requestRender(); return { render: (width: number) => [lastContext ? render(state, lastContext, width) : ""], invalidate: () => {} } as never; }, { placement: "belowEditor" });
+		if (!state.timer) state.timer = setInterval(() => { if (lastContext) void refreshDiff(state, lastContext); requestRender?.(); }, TICK_MS);
+	};
+	pi.on("session_start", (_event, ctx) => { restoreMeter(state, ctx); install(ctx); });
+	pi.on("session_shutdown", () => { if (state.timer) clearInterval(state.timer); state.timer = undefined; });
+	pi.on("turn_start", (_event, ctx) => { beginTurn(state.meter, Date.now()); install(ctx); });
+	pi.on("message_start", (event, ctx) => { const message = event.message as unknown as Record<string, unknown>; if (message.role === "assistant") beginStep(state.meter, String(message.timestamp ?? "assistant"), Date.now(), Date.now()); install(ctx); });
+	pi.on("message_update", (event, ctx) => { const update = event.assistantMessageEvent as { type?: string; delta?: string }; if (["text_delta", "thinking_delta", "toolcall_delta"].includes(update.type ?? "") && typeof update.delta === "string") observe(state.meter, Date.now(), update.delta.length); install(ctx); });
+	pi.on("assistant_message", (event, ctx) => { const message = event.message as unknown as Record<string, unknown>; const usage = asTokenRecord(message.usage); if (usage) state.lastUsage = usage; endStep(state.meter, String(message.timestamp ?? "assistant"), (usage?.output ?? 0) + (usage?.reasoning ?? 0), typeof message.completedAt === "number" ? message.completedAt : Date.now(), Date.now()); install(ctx); });
+	pi.on("turn_end", (_event, ctx) => { endTurn(state.meter, Date.now()); install(ctx); });
+}
