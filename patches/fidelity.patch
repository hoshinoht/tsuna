+export type NotifyEvent = "permission" | "question" | "complete" | "subagent_complete" | "error";
+export interface NotifyEventPayload { type: NotifyEvent; sessionId?: string; agent?: string; title?: string; key?: string }
+type Listener = (event: NotifyEventPayload) => void | Promise<void>;
+const listeners = new Set<Listener>();
+export function onNotifyEvent(listener: Listener): () => void { listeners.add(listener); return () => listeners.delete(listener); }
+export async function emitNotifyEvent(event: NotifyEventPayload): Promise<void> { await Promise.all([...listeners].map(listener => listener(event))); }
