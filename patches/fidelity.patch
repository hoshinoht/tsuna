+import { expect, test } from "bun:test";
+import { resolve } from "node:path";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent";
+import { contextColor, fitLine, type Segment } from "../packages/status-line-core/line.ts";
+import { PALETTE } from "../packages/status-line-core/palette.ts";
+
+test("status-line core retains threshold colors and narrow drop order", () => {
+	expect(contextColor(0.7)).toBe(PALETTE.contextWarning);
+	expect(contextColor(0.9)).toBe(PALETTE.contextCritical);
+	const segment = (id: Segment["id"], text: string): Segment => ({ id, runs: [{ text, fg: PALETTE.label }] });
+	expect(fitLine([segment("context", "cccc"), segment("cache", "kkkk"), segment("speed", "ssss"), segment("diff", "dddd"), segment("time", "tttt")], 11).map(run => run.text).join("")).toBe("cccc · ssss");
+});
+
+test("loads OMP status widget lifecycle hooks", async () => {
+	const loaded = await loadExtensions([resolve(import.meta.dir, "../extensions/status-line.ts")], import.meta.dir);
+	expect(loaded.errors).toEqual([]);
+	for (const event of ["session_start", "message_start", "message_update", "assistant_message", "turn_start", "turn_end", "session_shutdown"]) expect(loaded.extensions[0]!.handlers.has(event)).toBe(true);
+	let widget: ((tui: unknown, theme: unknown) => { render(width: number): string[] }) | undefined;
+	const ctx = {
+		hasUI: true,
+		cwd: import.meta.dir,
+		sessionManager: { getBranch: () => [] },
+		getContextUsage: () => ({ tokens: 75_000, contextWindow: 100_000, percent: 75 }),
+		ui: { setWidget: (_key: string, factory: typeof widget) => { widget = factory; } },
+	};
+	const start = loaded.extensions[0]!.handlers.get("session_start")![0] as (event: unknown, context: unknown) => void;
+	start({}, ctx);
+	expect(widget).toBeDefined();
+	expect(widget!({}, {}).render(8)).toHaveLength(1);
+	const shutdown = loaded.extensions[0]!.handlers.get("session_shutdown")![0] as (event: unknown, context: unknown) => void;
+	shutdown({}, ctx);
+});
