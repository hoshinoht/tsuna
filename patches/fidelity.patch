@@ -0,0 +1,31 @@
+import { expect, test } from "bun:test";
+import { mkdtemp, readdir, readFile, rm } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { tmpdir } from "node:os";
+import { parse } from "yaml";
+import { discoverSkills } from "@oh-my-pi/pi-coding-agent";
+import { frontmatter } from "../scripts/import-opencode";
+
+test("the actual OMP skill loader exposes all imported skill IDs including plugin development", async () => {
+  const root = resolve(import.meta.dir, "..");
+  const scratch = await mkdtemp(join(tmpdir(), "hoshi-skills-"));
+  try {
+    const skillDir = join(root, "agent/skills");
+    const expected: string[] = [];
+    for (const item of await readdir(skillDir, { withFileTypes: true })) {
+      if (item.isDirectory()) expected.push(frontmatter(await readFile(join(skillDir, item.name, "SKILL.md"), "utf8")).meta.name);
+    }
+    const config = parse(await readFile(join(root, "config/omp.yml"), "utf8"));
+    const result = await discoverSkills(scratch, undefined, {
+      ...config.skills, customDirectories: [skillDir], enablePiUser: false, enablePiProject: false,
+    });
+    for (const name of expected) expect(result.skills.map(s => s.name)).toContain(name);
+    expect(expected).toHaveLength(18);
+    const skill = result.skills.find(s => s.name === "opencode-plugin-dev");
+    expect(skill).toBeDefined();
+    const body = await readFile(skill!.filePath, "utf8");
+    expect(body).toContain("# Oh My Pi extension development");
+    expect(body).not.toContain("opencode api GET");
+    expect(body).toBe(await readFile(join(root, "config/skill-overrides/opencode-plugin-dev.md"), "utf8"));
+  } finally { await rm(scratch, { recursive: true, force: true }); }
+});
