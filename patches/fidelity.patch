+import { describe, expect, it } from "bun:test";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent";
+import { resolve } from "node:path";
+import { Notifier, defaultNotifierConfig, type NotifierAdapter } from "../lib/notifier.ts";
+
+describe("notifier", () => {
+	it("delivers desktop and sound channels, suppresses focused sessions, and deduplicates permission", async () => {
+		const calls: string[] = [];
+		const adapter: NotifierAdapter = { focused: () => false, desktop: async (_t, b) => { calls.push(`desktop:${b}`); }, sound: async (event, volume) => { calls.push(`sound:${event}:${volume}`); } };
+		const notifier = new Notifier(defaultNotifierConfig(), adapter);
+		await notifier.notify({ type: "permission", sessionId: "s", title: "repo" });
+		await notifier.notify({ type: "permission", sessionId: "s", title: "repo" });
+		expect(calls).toEqual(["desktop:repo", "sound:permission:1"]);
+		const focused = new Notifier(defaultNotifierConfig(), { ...adapter, focused: () => true });
+		await focused.notify({ type: "complete", title: "ignored" });
+		expect(calls).toHaveLength(2);
+	});
+	it("loads in OMP and ignores continuation agent ends while child completion remains muted", async () => {
+		const loaded = await loadExtensions([resolve(import.meta.dir, "../extensions/notifier.ts")], import.meta.dir);
+		expect(loaded.errors).toEqual([]);
+		const end = loaded.extensions[0]!.handlers.get("agent_end")![0] as (event: { willContinue?: boolean }, ctx: unknown) => Promise<void>;
+		await end({ willContinue: true }, { agent: { kind: "main", name: "build" }, sessionManager: { getSessionId: () => "s" }, cwd: "/tmp/repo" });
+		expect(loaded.extensions).toHaveLength(1);
+	});
+});
