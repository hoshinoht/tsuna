{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "tps": false,
    "terminal": true,
    "image_preview": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "terminal": {
    "copy": "select",
    "title": true
  },
  "scroll": {
    "acceleration": true
  },
  "tabs": {
    "enabled": true,
    "layout": "horizontal",
    "indicators": "status",
    "mode": "auto"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "debug": {
    "devtools": false
  },
  "plugins": [
    "./packages/status-line",
    "-opencode.notifications"
  ],
  "attention": {
    "sound": true,
    "volume": 0.9999999999999999
  }
}
