{
  "name": "tsuna-harness-experiment",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Experimental standalone Tsuna coding-agent harness (isolated from the installed Tsuna/OMP integration).",
  "bin": {
    "tsuna": "./bin/tsuna"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 30000 ./test",
    "build:native": "cargo build --locked --release --manifest-path native/supervisor/Cargo.toml --target-dir .cache/cargo-target",
    "test:native": "cargo test --locked --manifest-path native/supervisor/Cargo.toml --target-dir .cache/cargo-target",
    "demo": "bun ./scripts/demo.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@oh-my-pi/pi-ai": "18.8.6",
    "@oh-my-pi/pi-catalog": "18.8.6",
    "@oh-my-pi/pi-natives": "18.8.6",
    "@oh-my-pi/pi-utils": "18.8.6",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
