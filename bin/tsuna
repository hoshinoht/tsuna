#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname "$script")/.." && pwd -P)
binary="$root/native/tsuna/target/release/tsuna"
if [ ! -x "$binary" ]; then
  cargo build --locked --release --manifest-path "$root/native/tsuna/Cargo.toml"
fi
exec "$binary" --root "$root" "$@"
